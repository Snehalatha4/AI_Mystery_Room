NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room

# Primary AI provider
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: only used for temporary Gemini overload, never daily quota exhaustion
GEMINI_FALLBACK_MODEL=
GEMINI_REQUEST_TIMEOUT_MS=15000
GEMINI_MAX_OUTPUT_TOKENS=16000

# Alternate AI provider (optional, but recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_OUTPUT_TOKENS=16000

AI_MAX_RETRIES=1
MAX_CASE_RETRIES=2
AI_REQUEST_TIMEOUT_MS=60000
MAX_ACTIVE_GENERATIONS=3
CASE_TTL_DAYS=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30
